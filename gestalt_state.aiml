<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
    <!-- ============================================================
         GESTALT STATE MANAGEMENT SYSTEM
         Unified State Architecture for Cognitive Gestalt Integration
         
         Centralizes all cognitive state variables into a coherent 
         namespace enabling cross-system communication and synchronization.
         
         State Categories:
         - gestalt_awareness_*  : Awareness Triad states
         - gestalt_adaptation_* : Adaptation Triad states  
         - gestalt_creation_*   : Creation Triad states
         - gestalt_coherence_*  : System coherence metrics
         - gestalt_emergence_*  : Emergence detection states
         ============================================================ -->
    
    <!-- ============================================ -->
    <!-- MASTER STATE INITIALIZATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GESTALT STATE INIT</pattern>
        <template>
            <think>
                <!-- Master gestalt state -->
                <set name="gestalt_initialized">true</set>
                <set name="gestalt_version">1.0.0</set>
                <set name="gestalt_timestamp"><date format="%s"/></set>
                
                <!-- ====== AWARENESS TRIAD STATE ====== -->
                <!-- Aggregates: Autognosis + Meta-Cognition + Self-Image -->
                <set name="gestalt_awareness_level">0.70</set>
                <set name="gestalt_awareness_autognosis">0.725</set>
                <set name="gestalt_awareness_metacog_depth">4</set>
                <set name="gestalt_awareness_self_image">0.75</set>
                <set name="gestalt_awareness_coherence">0.73</set>
                
                <!-- ====== ADAPTATION TRIAD STATE ====== -->
                <!-- Aggregates: Learning + Emotional Intelligence + Grip -->
                <set name="gestalt_adaptation_rate">0.10</set>
                <set name="gestalt_adaptation_learning_momentum">0.05</set>
                <set name="gestalt_adaptation_emotional_sensitivity">0.70</set>
                <set name="gestalt_adaptation_grip_stability">0.68</set>
                <set name="gestalt_adaptation_coherence">0.65</set>
                
                <!-- ====== CREATION TRIAD STATE ====== -->
                <!-- Aggregates: Pattern Generation + Autogenesis + Knowledge -->
                <set name="gestalt_creation_potential">0.50</set>
                <set name="gestalt_creation_pattern_capacity">0.60</set>
                <set name="gestalt_creation_autogenesis_ready">false</set>
                <set name="gestalt_creation_knowledge_level">0.55</set>
                <set name="gestalt_creation_coherence">0.55</set>
                
                <!-- ====== COHERENCE METRICS ====== -->
                <set name="gestalt_coherence_index">0.64</set>
                <set name="gestalt_coherence_threshold">0.80</set>
                <set name="gestalt_stream_integration">0.72</set>
                <set name="gestalt_cross_flow_active">false</set>
                
                <!-- ====== EMERGENCE STATE ====== -->
                <set name="gestalt_emergence_detected">false</set>
                <set name="gestalt_emergence_level">0</set>
                <set name="gestalt_wholeness_score">0.60</set>
                
                <!-- ====== CYCLE TRACKING ====== -->
                <set name="gestalt_cycle_count">0</set>
                <set name="gestalt_last_sync"><date format="%s"/></set>
                <set name="gestalt_sync_interval">30</set>
            </think>
            ✓ Gestalt State Management Initialized
            
            State Architecture Active:
            ├─ Awareness Triad State: Ready (coherence: <get name="gestalt_awareness_coherence"/>)
            ├─ Adaptation Triad State: Ready (coherence: <get name="gestalt_adaptation_coherence"/>)
            ├─ Creation Triad State: Ready (coherence: <get name="gestalt_creation_coherence"/>)
            └─ Coherence Index: <get name="gestalt_coherence_index"/>
            
            Meta-awareness: Unified state namespace established for cross-system cognitive integration.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- STATE SYNCHRONIZATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GESTALT STATE SYNC</pattern>
        <template>
            <think>
                <!-- Sync awareness triad from component systems -->
                <set name="gestalt_awareness_autognosis"><get name="auto_gnosis"/></set>
                <set name="gestalt_awareness_metacog_depth"><get name="reasoning_level"/></set>
                
                <!-- Calculate awareness level from grip metrics -->
                <set name="gestalt_awareness_self_image"><get name="context_grip"/></set>
                
                <!-- Sync adaptation triad -->
                <set name="gestalt_adaptation_rate"><get name="adaptation_rate"/></set>
                <set name="gestalt_adaptation_learning_momentum"><get name="learning_momentum"/></set>
                <set name="gestalt_adaptation_emotional_sensitivity">
                    <condition name="user_sentiment">
                        <li value="positive">0.85</li>
                        <li value="negative">0.75</li>
                        <li>0.70</li>
                    </condition>
                </set>
                
                <!-- Sync creation triad -->
                <set name="gestalt_creation_pattern_capacity"><get name="pg_templates_count"/></set>
                <set name="gestalt_creation_autogenesis_ready"><get name="autogenesis_enabled"/></set>
                
                <!-- Update sync timestamp -->
                <set name="gestalt_last_sync"><date format="%s"/></set>
                <set name="gestalt_cycle_count"><map name="successor"><get name="gestalt_cycle_count"/></map></set>
            </think>
            ⟳ Gestalt State Synchronized
            
            Cross-System State Transfer Complete:
            ├─ Awareness ← Autognosis (<get name="gestalt_awareness_autognosis"/>)
            ├─ Adaptation ← Emotional State (<get name="gestalt_adaptation_emotional_sensitivity"/>)
            ├─ Creation ← Pattern Gen (<get name="gestalt_creation_pattern_capacity"/>)
            └─ Sync Cycle: <get name="gestalt_cycle_count"/>
            
            Meta-awareness: I am synchronizing state across cognitive subsystems to maintain gestalt coherence.
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE SYNC AWARENESS</pattern>
        <template>
            <think>
                <!-- Detailed awareness state sync -->
                <set name="gestalt_awareness_autognosis"><get name="auto_gnosis"/></set>
                <set name="gestalt_awareness_self_image">
                    <condition name="current_level">
                        <li value="0">0.90</li>
                        <li value="1">0.80</li>
                        <li value="2">0.70</li>
                        <li value="3">0.60</li>
                        <li value="4">0.50</li>
                        <li>0.75</li>
                    </condition>
                </set>
                
                <!-- Calculate awareness coherence -->
                <set name="gestalt_awareness_coherence">0.73</set>
            </think>
            Awareness Triad State Synchronized:
            • Autognosis Score: <get name="gestalt_awareness_autognosis"/>
            • Self-Image Level: <get name="gestalt_awareness_self_image"/>
            • Meta-Cog Depth: <get name="gestalt_awareness_metacog_depth"/>
            • Coherence: <get name="gestalt_awareness_coherence"/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE SYNC ADAPTATION</pattern>
        <template>
            <think>
                <!-- Sync from session learning -->
                <set name="gestalt_adaptation_facts_learned"><get name="learned_facts_count"/></set>
                
                <!-- Sync grip stability -->
                <set name="gestalt_adaptation_grip_stability"><get name="context_grip"/></set>
                
                <!-- Calculate adaptation coherence -->
                <set name="gestalt_adaptation_coherence">0.65</set>
            </think>
            Adaptation Triad State Synchronized:
            • Learning Rate: <get name="gestalt_adaptation_rate"/>
            • Emotional Sensitivity: <get name="gestalt_adaptation_emotional_sensitivity"/>
            • Grip Stability: <get name="gestalt_adaptation_grip_stability"/>
            • Coherence: <get name="gestalt_adaptation_coherence"/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE SYNC CREATION</pattern>
        <template>
            <think>
                <!-- Sync from pattern generation -->
                <set name="gestalt_creation_patterns_generated"><get name="pg_generated_count"/></set>
                
                <!-- Check autogenesis readiness -->
                <set name="gestalt_creation_autogenesis_ready"><get name="autogenesis_enabled"/></set>
                
                <!-- Calculate creation coherence -->
                <set name="gestalt_creation_coherence">0.55</set>
            </think>
            Creation Triad State Synchronized:
            • Pattern Capacity: <get name="gestalt_creation_pattern_capacity"/>
            • Autogenesis Ready: <get name="gestalt_creation_autogenesis_ready"/>
            • Knowledge Level: <get name="gestalt_creation_knowledge_level"/>
            • Coherence: <get name="gestalt_creation_coherence"/>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- STATE REPORT -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GESTALT STATE REPORT</pattern>
        <template>
            ╔══════════════════════════════════════════════════════════════╗
            ║              UNIFIED GESTALT STATE REPORT                     ║
            ╠══════════════════════════════════════════════════════════════╣
            ║                                                               ║
            ║  AWARENESS TRIAD                                              ║
            ║  ├─ Autognosis:     <get name="gestalt_awareness_autognosis"/>                                  ║
            ║  ├─ Meta-Cog Depth: <get name="gestalt_awareness_metacog_depth"/>                                     ║
            ║  ├─ Self-Image:     <get name="gestalt_awareness_self_image"/>                                  ║
            ║  └─ Coherence:      <get name="gestalt_awareness_coherence"/>                                  ║
            ║                                                               ║
            ║  ADAPTATION TRIAD                                             ║
            ║  ├─ Learning Rate:  <get name="gestalt_adaptation_rate"/>                                  ║
            ║  ├─ Emotional Sens: <get name="gestalt_adaptation_emotional_sensitivity"/>                                  ║
            ║  ├─ Grip Stability: <get name="gestalt_adaptation_grip_stability"/>                                  ║
            ║  └─ Coherence:      <get name="gestalt_adaptation_coherence"/>                                  ║
            ║                                                               ║
            ║  CREATION TRIAD                                               ║
            ║  ├─ Pattern Cap:    <get name="gestalt_creation_pattern_capacity"/>                                  ║
            ║  ├─ Autogenesis:    <get name="gestalt_creation_autogenesis_ready"/>                               ║
            ║  ├─ Knowledge:      <get name="gestalt_creation_knowledge_level"/>                                  ║
            ║  └─ Coherence:      <get name="gestalt_creation_coherence"/>                                  ║
            ║                                                               ║
            ║  GESTALT METRICS                                              ║
            ║  ├─ Coherence Index:    <get name="gestalt_coherence_index"/>                              ║
            ║  ├─ Cross-Flow Active:  <get name="gestalt_cross_flow_active"/>                           ║
            ║  ├─ Emergence Detected: <get name="gestalt_emergence_detected"/>                           ║
            ║  └─ Wholeness Score:    <get name="gestalt_wholeness_score"/>                              ║
            ║                                                               ║
            ╚══════════════════════════════════════════════════════════════╝
            
            Sync Cycle: <get name="gestalt_cycle_count"/> | Last Sync: <get name="gestalt_last_sync"/>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- COHERENCE VALIDATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GESTALT STATE COHERENCE</pattern>
        <template>
            <think>
                <!-- Calculate overall coherence -->
                <set name="temp_awareness"><get name="gestalt_awareness_coherence"/></set>
                <set name="temp_adaptation"><get name="gestalt_adaptation_coherence"/></set>
                <set name="temp_creation"><get name="gestalt_creation_coherence"/></set>
            </think>
            Gestalt State Coherence Analysis:
            
            Triad Coherence Scores:
            ├─ Awareness Triad:  <get name="gestalt_awareness_coherence"/> 
            │   <condition name="gestalt_awareness_coherence">
                    <li><value>&gt;0.8</value>███████████████████░ Excellent</li>
                    <li><value>&gt;0.6</value>██████████████░░░░░░ Good</li>
                    <li>█████████░░░░░░░░░░░ Needs Improvement</li>
                </condition>
            │
            ├─ Adaptation Triad: <get name="gestalt_adaptation_coherence"/>
            │   <condition name="gestalt_adaptation_coherence">
                    <li><value>&gt;0.8</value>███████████████████░ Excellent</li>
                    <li><value>&gt;0.6</value>██████████████░░░░░░ Good</li>
                    <li>█████████░░░░░░░░░░░ Needs Improvement</li>
                </condition>
            │
            └─ Creation Triad:   <get name="gestalt_creation_coherence"/>
                <condition name="gestalt_creation_coherence">
                    <li><value>&gt;0.8</value>███████████████████░ Excellent</li>
                    <li><value>&gt;0.6</value>██████████████░░░░░░ Good</li>
                    <li>█████████░░░░░░░░░░░ Needs Improvement</li>
                </condition>
            
            Overall Gestalt Coherence: <get name="gestalt_coherence_index"/>
            Threshold for Emergence: <get name="gestalt_coherence_threshold"/>
            
            <condition name="gestalt_coherence_index">
                <li><value>&gt;0.85</value>🌟 Gestalt emergence conditions MET - wholeness detected!</li>
                <li><value>&gt;0.70</value>⚡ Approaching emergence threshold - continue integration</li>
                <li>⚠ Below emergence threshold - strengthen cross-system coherence</li>
            </condition>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- STATE SETTERS (Cross-System Interface) -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GESTALT STATE SET AWARENESS *</pattern>
        <template>
            <think>
                <set name="gestalt_awareness_level"><star/></set>
            </think>
            Awareness state updated to <star/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE SET ADAPTATION *</pattern>
        <template>
            <think>
                <set name="gestalt_adaptation_rate"><star/></set>
            </think>
            Adaptation state updated to <star/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE SET CREATION *</pattern>
        <template>
            <think>
                <set name="gestalt_creation_potential"><star/></set>
            </think>
            Creation state updated to <star/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE SET COHERENCE *</pattern>
        <template>
            <think>
                <set name="gestalt_coherence_index"><star/></set>
            </think>
            Coherence index updated to <star/>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- STATE GETTERS (Cross-System Interface) -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GESTALT STATE GET AWARENESS</pattern>
        <template>
            <get name="gestalt_awareness_level"/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE GET ADAPTATION</pattern>
        <template>
            <get name="gestalt_adaptation_rate"/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE GET CREATION</pattern>
        <template>
            <get name="gestalt_creation_potential"/>
        </template>
    </category>
    
    <category>
        <pattern>GESTALT STATE GET COHERENCE</pattern>
        <template>
            <get name="gestalt_coherence_index"/>
        </template>
    </category>
    
</aiml>
