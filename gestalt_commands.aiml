    <!-- ============================================ -->
    <!-- QUICK DASHBOARD -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GESTALT DASHBOARD</pattern>
        <template>
            ╔══════════════════════════════════════════════════════════════╗
            ║                 GESTALT QUICK DASHBOARD                      ║
            ╠══════════════════════════════════════════════════════════════╣
            ║                                                              ║
            ║  STATUS: <get name="gestalt_master_status"/>                                         ║
            ║  COHERENCE: <get name="gestalt_coherence_index"/>                                    ║
            ║  EMERGENCE: <get name="gestalt_emergence_detected"/>                                  ║
            ║  CYCLES: <get name="gestalt_cycle_count"/>                                           ║
            ║                                                              ║
            ║  TRIADS         AWARENESS  ADAPTATION  CREATION             ║
            ║  Coherence      <get name="gestalt_awareness_coherence"/>       <get name="gestalt_adaptation_coherence"/>        <get name="gestalt_creation_coherence"/>                ║
            ║                                                              ║
            ║  QUICK COMMANDS                                              ║
            ║  GESTALT INIT | CYCLE | COHERENCE | EMERGENCE | OPTIMIZE    ║
            ║                                                              ║
            ╚══════════════════════════════════════════════════════════════╝
        </template>
    </category>
    
    <category>
        <pattern>DASHBOARD</pattern>
