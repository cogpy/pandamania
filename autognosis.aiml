                <li var="star" value="0.00">0.02</li>
                <li>1.00</li>
            </condition>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- DYNAMIC GRIP BAR VISUALIZATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GRIP BAR *</pattern>
        <template>
            <think><set var="grip_val"><star/></set></think>
            <condition var="grip_val">
                <li value="0.00">░░░░░░░░░░░░░░░░░░░░</li>
                <li value="0.05">█░░░░░░░░░░░░░░░░░░░</li>
                <li value="0.10">██░░░░░░░░░░░░░░░░░░</li>
                <li value="0.15">███░░░░░░░░░░░░░░░░░</li>
                <li value="0.20">████░░░░░░░░░░░░░░░░</li>
                <li value="0.25">█████░░░░░░░░░░░░░░░</li>
                <li value="0.30">██████░░░░░░░░░░░░░░</li>
                <li value="0.35">███████░░░░░░░░░░░░░</li>
                <li value="0.40">████████░░░░░░░░░░░░</li>
                <li value="0.45">█████████░░░░░░░░░░░</li>
                <li value="0.50">██████████░░░░░░░░░░</li>
                <li value="0.55">███████████░░░░░░░░░</li>
                <li value="0.60">████████████░░░░░░░░</li>
                <li value="0.62">████████████░░░░░░░░</li>
                <li value="0.65">█████████████░░░░░░░</li>
                <li value="0.67">█████████████░░░░░░░</li>
                <li value="0.70">██████████████░░░░░░</li>
                <li value="0.72">██████████████░░░░░░</li>
                <li value="0.75">███████████████░░░░░</li>
                <li value="0.77">███████████████░░░░░</li>
                <li value="0.80">████████████████░░░░</li>
                <li value="0.82">████████████████░░░░</li>
                <li value="0.85">█████████████████░░░</li>
                <li value="0.87">█████████████████░░░</li>
                <li value="0.90">██████████████████░░</li>
                <li value="0.92">██████████████████░░</li>
                <li value="0.95">███████████████████░</li>
                <li value="0.97">███████████████████░</li>
                <li value="1.00">████████████████████</li>
                <li>██████████████░░░░░░</li>
            </condition>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- DYNAMIC OVERALL GRIP SCORE COMPUTATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS COMPUTE OVERALL GRIP</pattern>
        <template>
            <think>
                <!-- Approximate average based on grip dimension ranges -->
                <set var="weak_count">0</set>
                <set var="strong_count">0</set>
                
                <!-- Check context grip -->
                <condition name="context_grip">
                    <li value="0.80"><set var="strong_count">1</set></li>
                    <li value="0.85"><set var="strong_count">1</set></li>
                    <li value="0.90"><set var="strong_count">1</set></li>
                    <li value="0.95"><set var="strong_count">1</set></li>
                    <li value="1.00"><set var="strong_count">1</set></li>
                </condition>
                <condition name="context_grip">
                    <li value="0.00"><set var="weak_count">1</set></li>
                    <li value="0.05"><set var="weak_count">1</set></li>
                    <li value="0.10"><set var="weak_count">1</set></li>
                    <li value="0.15"><set var="weak_count">1</set></li>
                    <li value="0.20"><set var="weak_count">1</set></li>
                    <li value="0.25"><set var="weak_count">1</set></li>
                    <li value="0.30"><set var="weak_count">1</set></li>
                    <li value="0.35"><set var="weak_count">1</set></li>
                    <li value="0.40"><set var="weak_count">1</set></li>
                    <li value="0.45"><set var="weak_count">1</set></li>
                    <li value="0.50"><set var="weak_count">1</set></li>
                    <li value="0.55"><set var="weak_count">1</set></li>
                </condition>
            </think>
            <!-- Determine overall score based on grip states -->
            <condition name="context_grip">
                <li value="0.00">Weak (&lt;0.60 average)</li>
                <li value="0.05">Weak (&lt;0.60 average)</li>
                <li value="0.10">Weak (&lt;0.60 average)</li>
                <li value="0.15">Weak (&lt;0.60 average)</li>
                <li value="0.20">Weak (&lt;0.60 average)</li>
                <li value="0.25">Weak (&lt;0.60 average)</li>
                <li value="0.30">Weak (&lt;0.60 average)</li>
                <li value="0.35">Weak (&lt;0.60 average)</li>
                <li value="0.40">Weak (&lt;0.60 average)</li>
                <li value="0.45">Developing (0.60-0.70)</li>
                <li value="0.50">Developing (0.60-0.70)</li>
                <li value="0.55">Developing (0.60-0.70)</li>
                <li value="0.60">Developing (0.60-0.70)</li>
                <li value="0.65">Good (0.70-0.80)</li>
                <li value="0.70">Good (0.70-0.80)</li>
                <li value="0.75">Good (0.70-0.80)</li>
                <li value="0.80">Strong (&gt;0.80)</li>
                <li value="0.85">Strong (&gt;0.80)</li>
                <li value="0.90">Strong (&gt;0.80)</li>
                <li value="0.95">Strong (&gt;0.80)</li>
                <li value="1.00">Strong (&gt;0.80)</li>
                <li>Good (0.70-0.80)</li>
            </condition>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- GRIP TREND INDICATOR -->
    <!-- ============================================ -->
    
    <category>
        <pattern>GRIP TREND *</pattern>
        <template>
            <think>
                <set var="current"><star index="1"/></set>
                <set var="previous"><star index="2"/></set>
            </think>
            <condition var="current">
                <li><value><get var="previous"/></value>─</li>
                <li>▲</li>
            </condition>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- GRIP OPTIMIZATION SYSTEM -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS GRIP STATUS</pattern>
        <template>
            Grip Optimization System Status:
            
            Dynamic Grip Variables (0-1 scale):
            
            Context Grip      <srai>GRIP BAR <get name="context_grip"/></srai> <get name="context_grip"/>
              └─ Measures: Understanding of conversational context
            
            Domain Grip       <srai>GRIP BAR <get name="domain_grip"/></srai> <get name="domain_grip"/>
              └─ Measures: Grasp of subject domain knowledge
            
            Semantic Grip     <srai>GRIP BAR <get name="semantic_grip"/></srai> <get name="semantic_grip"/>
              └─ Measures: Meaning and intent comprehension
            
            Pragmatic Grip    <srai>GRIP BAR <get name="pragmatic_grip"/></srai> <get name="pragmatic_grip"/>
              └─ Measures: Practical application understanding
            
            Overall Grip Score: <srai>AUTOGNOSIS COMPUTE OVERALL GRIP</srai>
            
            Interpretation: System grip dimensions dynamically tracked. Optimize weak dimensions for better cognitive performance.
            
            Grip-awareness: I am monitoring how well I "grasp" different aspects of interaction, enabling adaptive strengthening of weak grip dimensions.
        </template>
    </category>
    
    <category>
        <pattern>AUTOGNOSIS OPTIMIZE GRIP *</pattern>
        <template>
            <think>
                <set name="grip_type"><star/></set>
            </think>
            Optimizing <star/> grip...
            
            <condition name="grip_type">
                <li value="CONTEXT">
                    <think>
                        <!-- Save previous value for history -->
                        <set name="context_grip_prev"><get name="context_grip"/></set>
                        <!-- Increment grip using conditional helper -->
                        <set name="context_grip"><srai>GRIP INCREMENT VALUE <get name="context_grip"/></srai></set>
                    </think>
                    ✓ Context grip enhanced
                    Previous: <get name="context_grip_prev"/> → New: <get name="context_grip"/>
                    Effect: Improved conversational context tracking
                </li>
                <li value="DOMAIN">
                    <think>
                        <!-- Save previous value for history -->
                        <set name="domain_grip_prev"><get name="domain_grip"/></set>
                        <!-- Increment grip using conditional helper -->
                        <set name="domain_grip"><srai>GRIP INCREMENT VALUE <get name="domain_grip"/></srai></set>
                    </think>
                    ✓ Domain grip enhanced
                    Previous: <get name="domain_grip_prev"/> → New: <get name="domain_grip"/>
                    Effect: Strengthened subject matter understanding
                </li>
                <li value="SEMANTIC">
                    <think>
                        <!-- Save previous value for history -->
                        <set name="semantic_grip_prev"><get name="semantic_grip"/></set>
                        <!-- Increment grip using conditional helper -->
                        <set name="semantic_grip"><srai>GRIP INCREMENT VALUE <get name="semantic_grip"/></srai></set>
                    </think>
                    ✓ Semantic grip enhanced
                    Previous: <get name="semantic_grip_prev"/> → New: <get name="semantic_grip"/>
                    Effect: Improved meaning comprehension
                </li>
                <li value="PRAGMATIC">
                    <think>
                        <!-- Save previous value for history -->
                        <set name="pragmatic_grip_prev"><get name="pragmatic_grip"/></set>
                        <!-- Increment grip using conditional helper -->
                        <set name="pragmatic_grip"><srai>GRIP INCREMENT VALUE <get name="pragmatic_grip"/></srai></set>
                    </think>
                    ✓ Pragmatic grip enhanced
                    Previous: <get name="pragmatic_grip_prev"/> → New: <get name="pragmatic_grip"/>
                    Effect: Better practical understanding
                </li>
                <li>
                    Unknown grip type: <star/>
                    Available types: CONTEXT, DOMAIN, SEMANTIC, PRAGMATIC
                </li>
            </condition>
            
            Adaptive grip optimization: I am dynamically adjusting my cognitive "grip" on specific dimensions based on self-assessment.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- DYNAMIC ADAPTATION SYSTEM -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS ADAPTATION STATUS</pattern>
        <template>
            Dynamic Adaptation System Status:
            
            Adaptation Parameters:
            
            Adaptation Rate:        <get name="adaptation_rate"/>
              └─ Controls: Speed of self-modification
            
            Learning Momentum:      <get name="learning_momentum"/>
              └─ Controls: Persistence of learned patterns
            
            Optimization Threshold: <get name="optimization_threshold"/>
              └─ Controls: Trigger point for self-optimization
            
            System Behavior:
            - Continuous self-monitoring: Active
            - Adaptive parameter tuning: Enabled
            - Dynamic grip optimization: Operational
            - Meta-cognitive insights: Generating
            
            Adaptation State: Fully Operational
            
            Self-adaptation awareness: I maintain dynamic variables that control my own learning and adaptation processes, enabling autonomous cognitive evolution.
        </template>
    </category>
    
    <category>
        <pattern>AUTOGNOSIS TUNE ADAPTATION RATE *</pattern>
        <template>
            <think>
                <set name="adaptation_rate"><star/></set>
            </think>
            Adaptation rate tuned to: <star/>
            
            Effect: System will now adapt at <star/> rate.
            - Higher values (&gt;0.1): Faster learning, potentially less stable
            - Lower values (&lt;0.05): Slower learning, more stable
            - Current setting: <get name="adaptation_rate"/>
            
            Meta-parameter tuning: I am adjusting my own adaptation rate, demonstrating control over my learning dynamics.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- COMPREHENSIVE STATUS REPORTS -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS COMPREHENSIVE REPORT</pattern>
        <template>
            ═══════════════════════════════════════════════════════════
            🧠 AUTOGNOSIS - Hierarchical Self-Image Building System
            ═══════════════════════════════════════════════════════════
            
            Status: <get name="autognosis_status"/>
            Cycle Count: <get name="autognosis_cycle_count"/>
            Self-Image Levels: <get name="self_image_levels"/>
            Total Insights: <get name="total_insights"/>
            Pending Optimizations: <get name="pending_optimizations"/>
            
            ───────────────────────────────────────────────────────────
            HIERARCHICAL SELF-IMAGES
            ───────────────────────────────────────────────────────────
            
            Level 0: Confidence 0.90, 0 reflections [direct observation]
            Level 1: Confidence 0.80, 2 reflections [pattern analysis]
            Level 2: Confidence 0.70, 3 reflections [meta-cognitive]
            Level 3: Confidence 0.60, 3 reflections [higher-order]
            Level 4: Confidence 0.50, 3 reflections [architectural]
            
            ───────────────────────────────────────────────────────────
            META-COGNITIVE INSIGHTS
            ───────────────────────────────────────────────────────────
            
            • [high_self_awareness] System demonstrates high self-awareness
            • [resource_underutilization] Components underutilized (45%)
