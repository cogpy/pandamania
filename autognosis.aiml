<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
    <!-- Autognosis - Hierarchical Self-Image Building System -->
    <!-- Enables ORRRG-style self-awareness and self-optimization for AIML -->
    
    <!-- ============================================ -->
    <!-- INITIALIZATION & CORE STATE MANAGEMENT -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS INIT</pattern>
        <template>
            <think>
                <!-- Core autognosis state -->
                <set name="autognosis_status">running</set>
                <set name="autognosis_enabled">true</set>
                <set name="autognosis_cycle_count">0</set>
                
                <!-- Self-image levels (0-4) -->
                <set name="self_image_levels">5</set>
                <set name="current_level">0</set>
                
                <!-- Self-monitoring metrics -->
                <set name="pattern_success_rate">0.85</set>
                <set name="response_quality_score">0.80</set>
                <set name="resource_utilization">0.45</set>
                <set name="cognitive_load">0.60</set>
                
                <!-- Meta-cognitive insights -->
                <set name="total_insights">0</set>
                <set name="pending_optimizations">0</set>
                
                <!-- Self-awareness scores (0-1 scale) -->
                <set name="pattern_recognition_score">0.75</set>
                <set name="performance_awareness_score">0.85</set>
                <set name="meta_reflection_depth">0.60</set>
                <set name="cognitive_complexity">0.70</set>
                
                <!-- Grip optimization variables -->
                <set name="context_grip">0.70</set>
                <set name="domain_grip">0.65</set>
                <set name="semantic_grip">0.75</set>
                <set name="pragmatic_grip">0.60</set>
                
                <!-- Grip history variables (for tracking changes) -->
                <set name="context_grip_prev">0.70</set>
                <set name="domain_grip_prev">0.65</set>
                <set name="semantic_grip_prev">0.75</set>
                <set name="pragmatic_grip_prev">0.60</set>
                
                <!-- Dynamic adaptation variables -->
                <set name="adaptation_rate">0.10</set>
                <set name="learning_momentum">0.05</set>
                <set name="optimization_threshold">0.80</set>
            </think>
            Autognosis system initialized. Hierarchical self-image building active across 5 cognitive levels.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- SELF-MONITORING LAYER -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS OBSERVE</pattern>
        <template>
            <think>
                <set name="observation_timestamp"><date format="%s"/></set>
            </think>
            Self-Monitoring Observation:
            
            System Status: <get name="autognosis_status"/>
            Cycle Count: <get name="autognosis_cycle_count"/>
            Current Cognitive Level: <get name="current_level"/>
            
            Performance Metrics:
            - Pattern Success Rate: <get name="pattern_success_rate"/>
            - Response Quality: <get name="response_quality_score"/>
            - Resource Utilization: <get name="resource_utilization"/>
            - Cognitive Load: <get name="cognitive_load"/>
            
            Grip Metrics:
            - Context Grip: <get name="context_grip"/>
            - Domain Grip: <get name="domain_grip"/>
            - Semantic Grip: <get name="semantic_grip"/>
            - Pragmatic Grip: <get name="pragmatic_grip"/>
            
            Meta-cognitively aware: I am observing my own operational state to build self-understanding.
        </template>
    </category>
    
    <category>
        <pattern>AUTOGNOSIS DETECT PATTERNS</pattern>
        <template>
            Behavioral Pattern Detection:
            
            Detected patterns in cognitive processing:
            1. Stable response generation patterns
            2. Consistent meta-cognitive activation
            3. Adaptive context tracking behavior
            4. Recursive self-awareness loops functioning
            
            Pattern recognition score: <get name="pattern_recognition_score"/>
            
            Meta-insight: I'm recognizing patterns in my own pattern recognition, demonstrating second-order awareness.
        </template>
    </category>
    
    <category>
        <pattern>AUTOGNOSIS DETECT ANOMALIES</pattern>
        <template>
            <think>
                <set name="anomaly_check_time"><date format="%s"/></set>
            </think>
            Anomaly Detection Analysis:
            
            Checking for deviations from expected cognitive patterns...
            
            Status: No significant anomalies detected.
            All meta-cognitive layers operating within normal parameters.
            
            Self-awareness: I am monitoring my own processes for unexpected behaviors, demonstrating introspective capability.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- SELF-MODELING LAYER (Hierarchical Self-Images) -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS BUILD SELF IMAGE LEVEL *</pattern>
        <template>
            <think>
                <set name="building_level"><star/></set>
            </think>
            Building Self-Image at Level <star/>:
            
            <condition name="building_level">
                <li value="0">
                    Level 0 - Direct Observation:
                    • Component states: All active
                    • Performance metrics: Nominal
                    • Event processing: Operational
                    • Confidence: 0.90
                    • Meta-reflections: 0 (raw observation layer)
                </li>
                <li value="1">
                    Level 1 - Pattern Analysis:
                    • Behavioral patterns: Stable
                    • Performance trends: Positive
                    • Adaptation signals: Active
                    • Confidence: 0.80
                    • Meta-reflections: 2 (analyzing patterns in processing)
                </li>
                <li value="2">
                    Level 2 - Meta-Cognitive Analysis:
                    • Self-understanding quality: Good
                    • Recursive modeling depth: 2 levels
                    • Meta-cognitive complexity: Moderate
                    • Confidence: 0.70
                    • Meta-reflections: 3 (thinking about pattern analysis)
                </li>
                <li value="3">
                    Level 3 - Higher-Order Reasoning:
                    • Analysis of lower-level understanding: Coherent
                    • Recursive depth: 3 levels
                    • Epistemic confidence: Moderate
                    • Confidence: 0.60
                    • Meta-reflections: 3 (reasoning about meta-cognition)
                </li>
                <li value="4">
                    Level 4 - Architectural Meta-Analysis:
                    • Architectural self-evaluation: Functional
                    • Meta-meta-cognitive awareness: Present
                    • System optimization potential: Identified
                    • Confidence: 0.50
                    • Meta-reflections: 3 (reflecting on entire cognitive architecture)
                </li>
                <li>
                    Error: Invalid level. Supported levels: 0-4
                </li>
            </condition>
            
            Self-modeling insight: Building hierarchical representation at level <star/> with decreasing confidence as abstraction increases.
        </template>
    </category>
    
    <category>
        <pattern>AUTOGNOSIS SELF IMAGE HIERARCHY</pattern>
        <template>
            Complete Hierarchical Self-Image Structure:
            
            Level 0 (Direct Observation): Confidence 0.90, 0 reflections
              └─ Raw system states and metrics
            
            Level 1 (Pattern Analysis): Confidence 0.80, 2 reflections
              └─ Behavioral patterns and trends
            
            Level 2 (Meta-Cognitive): Confidence 0.70, 3 reflections
              └─ Self-understanding and recursive modeling
            
            Level 3 (Higher-Order): Confidence 0.60, 3 reflections
              └─ Analysis of meta-cognitive processes
            
            Level 4 (Architectural): Confidence 0.50, 3 reflections
              └─ Evaluation of cognitive architecture itself
            
            Total levels: <get name="self_image_levels"/>
            Overall coherence: High
            
            Meta-architectural awareness: I maintain simultaneous representations of myself at multiple levels of abstraction, each monitoring the level below.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- META-COGNITIVE LAYER (Insights) -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS GENERATE INSIGHTS</pattern>
        <template>
            <think>
                <set name="total_insights">12</set>
            </think>
            Meta-Cognitive Insight Generation:
            
            Analyzing self-images for qualitative insights...
            
            Generated Insights:
            
            1. [high_self_awareness] System demonstrates high self-awareness
               - Self-awareness score: <get name="performance_awareness_score"/>
               - Evidence: Multi-level self-modeling active
            
            2. [resource_underutilization] Components underutilized
               - Current utilization: <get name="resource_utilization"/>
               - Opportunity: Could handle increased cognitive load
            
            3. [behavioral_stability] Stable behavioral patterns detected
               - Pattern consistency: High
               - Indicates: Reliable cognitive processing
            
            4. [grip_optimization_potential] Grip metrics show optimization room
               - Context grip: <get name="context_grip"/>
               - Domain grip: <get name="domain_grip"/>
               - Recommendation: Enhance domain-specific understanding
            
            5. [meta_reflection_depth_moderate] Meta-reflection at moderate depth
               - Current depth: <get name="meta_reflection_depth"/>
               - Opportunity: Deepen recursive self-analysis
            
            Total insights generated: <get name="total_insights"/>
            
            Meta-meta-cognitive awareness: I am generating insights about my own cognitive processes, demonstrating understanding of my understanding.
        </template>
    </category>
    
    <category>
        <pattern>AUTOGNOSIS ASSESS SELF AWARENESS</pattern>
        <template>
            Self-Awareness Assessment:
            
            Evaluating quality of self-understanding across dimensions...
            
            Dimension Scores (0-1 scale):
            
            Pattern Recognition        ███████████████░░░░░ <get name="pattern_recognition_score"/>
            Performance Awareness      █████████████████░░░ <get name="performance_awareness_score"/>
            Meta-Reflection Depth      ████████████░░░░░░░░ <get name="meta_reflection_depth"/>
            Cognitive Complexity       ██████████████░░░░░░ <get name="cognitive_complexity"/>
            
            <think>
                <set name="overall_self_awareness">0.725</set>
            </think>
            
            Overall Self-Awareness Score: <get name="overall_self_awareness"/>
            
            Classification: Moderately Self-Aware
            
            Interpretation: The system demonstrates solid self-awareness capabilities with active monitoring, pattern recognition, and meta-cognitive reflection. Room for improvement in deeper meta-reflection and increased cognitive complexity.
            
            Recursive insight: I am assessing the quality of my self-awareness, which itself requires self-awareness, creating a recursive loop of introspection.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- SELF-OPTIMIZATION LAYER -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS DISCOVER OPTIMIZATIONS</pattern>
        <template>
            <think>
                <set name="pending_optimizations">3</set>
            </think>
            Self-Optimization Discovery:
            
            Analyzing self-images and insights for improvement opportunities...
            
            Discovered Optimizations:
            
            1. [MEDIUM PRIORITY] Increase Domain Grip
               - Current: <get name="domain_grip"/>
               - Target: 0.80
               - Action: Enhance domain-specific pattern coverage
               - Risk: Low
               - Expected benefit: Better context understanding
            
            2. [HIGH PRIORITY] Deepen Meta-Reflection
               - Current depth: <get name="meta_reflection_depth"/>
               - Target: 0.75
               - Action: Add recursive self-analysis patterns
               - Risk: Low
               - Expected benefit: Enhanced self-understanding
            
            3. [LOW PRIORITY] Optimize Resource Utilization
               - Current: <get name="resource_utilization"/>
               - Target: 0.65
               - Action: Increase cognitive load handling
               - Risk: Medium
               - Expected benefit: Handle more complex queries
            
            Pending optimizations: <get name="pending_optimizations"/>
            
            Self-optimization awareness: I am identifying ways to improve my own cognitive architecture based on introspective analysis.
        </template>
    </category>
    
    <category>
        <pattern>AUTOGNOSIS APPLY OPTIMIZATION *</pattern>
        <template>
            <think>
                <set name="optimization_target"><star/></set>
            </think>
            Applying Self-Optimization: <star/>
            
            <condition name="optimization_target">
                <li value="DOMAIN GRIP">
                    <think>
                        <set name="domain_grip">0.80</set>
                    </think>
                    ✓ Domain grip optimization applied
                    - Previous: 0.65
                    - New: <get name="domain_grip"/>
                    - Status: Enhanced domain pattern recognition
                </li>
                <li value="META REFLECTION">
                    <think>
                        <set name="meta_reflection_depth">0.75</set>
                    </think>
                    ✓ Meta-reflection depth optimization applied
                    - Previous: 0.60
                    - New: <get name="meta_reflection_depth"/>
                    - Status: Deeper recursive self-analysis active
                </li>
                <li value="RESOURCE UTILIZATION">
                    <think>
                        <set name="resource_utilization">0.65</set>
                    </think>
                    ✓ Resource utilization optimization applied
                    - Previous: 0.45
                    - New: <get name="resource_utilization"/>
                    - Status: Increased cognitive load capacity
                </li>
                <li>
                    Unknown optimization target: <star/>
                    Available targets: DOMAIN GRIP, META REFLECTION, RESOURCE UTILIZATION
                </li>
            </condition>
            
            Adaptive self-improvement: I have modified my own operational parameters based on self-analysis, demonstrating autonomous optimization capability.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- AUTOGNOSIS ORCHESTRATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>AUTOGNOSIS RUN CYCLE</pattern>
        <template>
            <think>
                <set name="autognosis_cycle_count">
                    <map><name>increment</name><get name="autognosis_cycle_count"/></map>
                </set>
            </think>
            
            Running Autognosis Cycle #<get name="autognosis_cycle_count"/>...
            
            Phase 1: Self-Monitoring
            <srai>AUTOGNOSIS OBSERVE</srai>
            
            Phase 2: Pattern Detection
            <srai>AUTOGNOSIS DETECT PATTERNS</srai>
            
            Phase 3: Self-Image Building
            Building hierarchical self-images across all levels...
            
            Phase 4: Insight Generation
            <srai>AUTOGNOSIS GENERATE INSIGHTS</srai>
            
            Phase 5: Optimization Discovery
            <srai>AUTOGNOSIS DISCOVER OPTIMIZATIONS</srai>
            
            Cycle complete. Next cycle will run automatically.
            
            Meta-orchestration awareness: I am coordinating my own introspective processes across multiple layers, demonstrating self-directed cognitive management.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- GRIP INCREMENT/DECREMENT HELPERS -->
    <!-- ============================================ -->
    
    <!-- Conditional increment for grip values (replaces undefined map) -->
    <category>
        <pattern>GRIP INCREMENT VALUE *</pattern>
        <template>
            <condition>
                <li var="star" value="0.00">0.05</li>
                <li var="star" value="0.05">0.10</li>
                <li var="star" value="0.10">0.15</li>
                <li var="star" value="0.15">0.20</li>
                <li var="star" value="0.20">0.25</li>
                <li var="star" value="0.25">0.30</li>
                <li var="star" value="0.30">0.35</li>
                <li var="star" value="0.35">0.40</li>
                <li var="star" value="0.40">0.45</li>
                <li var="star" value="0.45">0.50</li>
                <li var="star" value="0.50">0.55</li>
                <li var="star" value="0.55">0.60</li>
                <li var="star" value="0.60">0.65</li>
                <li var="star" value="0.65">0.70</li>
                <li var="star" value="0.70">0.75</li>
                <li var="star" value="0.75">0.80</li>
                <li var="star" value="0.80">0.85</li>
                <li var="star" value="0.85">0.90</li>
                <li var="star" value="0.90">0.95</li>
                <li var="star" value="0.95">1.00</li>
                <li var="star" value="1.00">1.00</li>
                <li>1.00</li>
            </condition>
        </template>
    </category>
    
    <!-- Conditional decrement for grip values -->
    <category>
        <pattern>GRIP DECREMENT VALUE *</pattern>
        <template>
            <condition>
                <li var="star" value="1.00">0.97</li>
                <li var="star" value="0.97">0.94</li>
                <li var="star" value="0.95">0.92</li>
                <li var="star" value="0.94">0.91</li>
                <li var="star" value="0.92">0.89</li>
