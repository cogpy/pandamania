        </template>
    </category>
    
    <!-- Small reinforcement increment for positive feedback -->
    <category>
        <pattern>GRIP REINFORCE VALUE *</pattern>
        <template>
            <condition>
                <li var="star" value="0.98">1.00</li>
                <li var="star" value="0.99">1.00</li>
                <li var="star" value="1.00">1.00</li>
                <li var="star" value="0.97">0.99</li>
                <li var="star" value="0.96">0.98</li>
                <li var="star" value="0.95">0.97</li>
