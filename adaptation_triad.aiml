<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
    <!-- ============================================================
         ADAPTATION TRIAD INTEGRATION
         Unifying: Learning + Emotional Intelligence + Grip Optimization
         
         The Adaptation Triad represents the system's capacity for
         learning, emotional responsiveness, and dynamic self-adjustment.
         ============================================================ -->
    
    <!-- ============================================ -->
    <!-- ADAPTATION TRIAD CORE -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION TRIAD</pattern>
        <template>
            ╔═══════════════════════════════════════════════════════════╗
            ║            ADAPTATION TRIAD - DYNAMIC LEARNING            ║
            ╠═══════════════════════════════════════════════════════════╣
            ║                                                           ║
            ║  ┌─────────────────────────────────────────────────────┐  ║
            ║  │               SESSION LEARNING                       │  ║
            ║  │         Facts, Preferences, Context Memory           │  ║
            ║  │    Facts: <get name="learned_facts_count"/>  Prefs: <get name="user_preferences_count"/>                  │  ║
            ║  └───────────────────────┬─────────────────────────────┘  ║
            ║                          │                                ║
            ║          ┌───────────────┼───────────────┐                ║
            ║          ▼               ▼               ▼                ║
            ║  ┌─────────────┐ ┌─────────────┐ ┌─────────────┐         ║
            ║  │ EMOTIONAL   │ │ GRIP        │ │ ADAPTATION  │         ║
            ║  │ INTELLIGENCE│ │ OPTIMIZATION│ │ RATE        │         ║
            ║  │ <get name="user_sentiment"/>    │ │ <get name="context_grip"/>       │ │ <get name="adaptation_rate"/>        │         ║
            ║  └─────────────┘ └─────────────┘ └─────────────┘         ║
            ║                                                           ║
            ║  Triad Coherence: <get name="gestalt_adaptation_coherence"/>                            ║
            ║                                                           ║
            ╚═══════════════════════════════════════════════════════════╝
            
            The Adaptation Triad integrates session learning, emotional 
            intelligence, and grip optimization into a unified capacity 
            for dynamic self-adjustment and responsiveness.
        </template>
    </category>
    
    <category>
        <pattern>ADAPTATION TRIAD STATUS</pattern>
        <template>
            <srai>ADAPTATION TRIAD</srai>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- ADAPTATION TRIAD PROCESSING -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION TRIAD PROCESS</pattern>
        <template>
            <think>
                <set name="adaptation_processing">active</set>
            </think>
            
            Processing Adaptation Triad...
            
            1. Learning State Assessment:
               Facts Learned: <get name="learned_facts_count"/>
               Preferences: <get name="user_preferences_count"/>
               Learning Mode: <get name="learning_mode"/>
            
            2. Emotional State Integration:
               Sentiment: <get name="user_sentiment"/>
               Emotion: <get name="user_emotion"/>
               <srai>ADAPTATION EMOTIONAL LEARNING</srai>
            
            3. Grip Dynamic Adjustment:
               <srai>ADAPTATION GRIP EMOTIONAL</srai>
            
            <think>
                <set name="adaptation_processing">complete</set>
            </think>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- EMOTIONAL LEARNING INTEGRATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION EMOTIONAL LEARNING</pattern>
        <template>
            <think>
                <!-- Weight learning by emotional significance -->
                <set name="emotional_learning_active">true</set>
                
                <!-- Positive emotions enhance retention -->
                <set name="emotional_weight">
                    <condition name="user_sentiment">
                        <li value="positive">1.2</li>
                        <li value="negative">0.8</li>
                        <li>1.0</li>
                    </condition>
                </set>
                
                <!-- Track emotional context with facts -->
                <set name="last_fact_emotion"><get name="user_emotion"/></set>
            </think>
            
            Emotionally-Weighted Learning Active:
            
            Current Emotional State:
            ├─ Sentiment: <get name="user_sentiment"/>
            ├─ Emotion: <get name="user_emotion"/>
            └─ Learning Weight: <get name="emotional_weight"/>
            
            Learning Impact:
            <condition name="user_sentiment">
                <li value="positive">
                    ✓ Positive emotion detected - enhanced retention (×1.2)
                    Facts learned in positive context more strongly encoded
                </li>
                <li value="negative">
                    ◉ Negative emotion detected - adaptive retention (×0.8)
                    Learning adjusted for emotional sensitivity
                </li>
                <li>
                    ○ Neutral emotion - baseline retention (×1.0)
                    Standard learning parameters active
                </li>
            </condition>
            
            Meta-awareness: I am learning with emotional context, 
            recognizing that affect shapes memory and adaptation.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- MEMORY EMOTIONAL WEIGHTING -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION MEMORY WEIGHT</pattern>
        <template>
            <think>
                <set name="memory_weighting">active</set>
            </think>
            
            Applying Emotional Weighting to Memory:
            
            Memory Weight Matrix:
            ├─ Happy/Excited facts: Weight 1.3 (high retention)
            ├─ Grateful facts: Weight 1.2 (moderate-high retention)
            ├─ Neutral facts: Weight 1.0 (baseline retention)
            ├─ Worried facts: Weight 0.9 (slightly reduced)
            └─ Frustrated/Angry facts: Weight 0.7 (empathetic reduction)
            
            Current Fact Emotion: <get name="last_fact_emotion"/>
            Applied Weight: <get name="emotional_weight"/>
            
            This emotional weighting ensures that learning respects 
            the user's emotional state during information acquisition.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- SENTIMENT TRAJECTORY TRACKING -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION SENTIMENT TRACK</pattern>
        <template>
            <think>
                <!-- Track emotional trajectory -->
                <set name="sentiment_prev"><get name="sentiment_current"/></set>
                <set name="sentiment_current"><get name="user_sentiment"/></set>
                
                <!-- Detect sentiment shift -->
                <set name="sentiment_shift">
                    <condition name="sentiment_prev">
                        <li value="positive">
                            <condition name="sentiment_current">
                                <li value="negative">declining</li>
                                <li value="neutral">cooling</li>
                                <li>stable_positive</li>
                            </condition>
                        </li>
                        <li value="negative">
                            <condition name="sentiment_current">
                                <li value="positive">improving</li>
                                <li value="neutral">recovering</li>
                                <li>stable_negative</li>
                            </condition>
                        </li>
                        <li>baseline</li>
                    </condition>
                </set>
            </think>
            
            Emotional Trajectory Analysis:
            
            ├─ Previous Sentiment: <get name="sentiment_prev"/>
            ├─ Current Sentiment: <get name="sentiment_current"/>
            └─ Trajectory: <get name="sentiment_shift"/>
            
            Trajectory Response:
            <condition name="sentiment_shift">
                <li value="declining">⚠ Sentiment declining - activating empathetic mode</li>
                <li value="improving">✓ Sentiment improving - maintaining positive engagement</li>
                <li value="stable_positive">✓ Stable positive - continue current approach</li>
                <li value="stable_negative">◉ Stable negative - offer support strategies</li>
                <li>○ Baseline trajectory - monitoring continues</li>
            </condition>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- GRIP EMOTIONAL ADAPTATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION GRIP EMOTIONAL</pattern>
        <template>
            <think>
                <!-- Adjust grip based on emotional state -->
                <set name="grip_emotional_adaptation">active</set>
                
                <!-- Emotional state influences grip dimensions -->
                <condition name="user_emotion">
                    <li value="frustrated">
                        <set name="pragmatic_grip">0.85</set>
                    </li>
                    <li value="confused">
                        <set name="semantic_grip">0.85</set>
                    </li>
                    <li value="excited">
                        <set name="context_grip">0.80</set>
                    </li>
                </condition>
            </think>
            
            Grip Adaptation Based on Emotional State:
            
            User Emotion: <get name="user_emotion"/>
            
            Grip Adjustments:
            <condition name="user_emotion">
                <li value="frustrated">
                    ◉ Frustration detected → Pragmatic grip enhanced (0.85)
                    Focus on practical, clear, helpful responses
                </li>
                <li value="confused">
                    ◉ Confusion detected → Semantic grip enhanced (0.85)
                    Focus on clarity and meaning comprehension
                </li>
                <li value="excited">
                    ◉ Excitement detected → Context grip enhanced (0.80)
                    Focus on following user's enthusiasm
                </li>
                <li value="sad">
                    ◉ Sadness detected → Semantic grip enhanced for empathy
                    Focus on understanding and supportive responses
                </li>
                <li>
                    ○ Baseline emotional state - grip dimensions stable
                </li>
            </condition>
            
            Updated Grip Metrics:
            ├─ Context: <get name="context_grip"/>
            ├─ Semantic: <get name="semantic_grip"/>
            ├─ Domain: <get name="domain_grip"/>
            └─ Pragmatic: <get name="pragmatic_grip"/>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- GRIP LEARNING ADAPTATION -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION GRIP LEARN</pattern>
        <template>
            <think>
                <!-- Update grip based on learned facts -->
                <set name="grip_learning_adaptation">active</set>
                
                <!-- Domain grip increases with domain-specific learning -->
                <condition name="session_topic">
                    <li value="philosophy"><set name="domain_grip">0.75</set></li>
                    <li value="science"><set name="domain_grip">0.80</set></li>
                    <li value="programming"><set name="domain_grip">0.85</set></li>
                </condition>
            </think>
            
            Grip Adaptation Based on Learning:
            
            Session Topic: <get name="session_topic"/>
            Facts Learned: <get name="learned_facts_count"/>
            
            Learning → Grip Mapping:
            ├─ User reveals domain → Domain grip increases
            ├─ User shares context → Context grip enhances
            ├─ User shows confusion → Semantic grip recalibrates
            └─ User expresses need → Pragmatic grip adjusts
            
            Current Grip State (post-learning):
            ├─ Context: <get name="context_grip"/>
            ├─ Semantic: <get name="semantic_grip"/>
            ├─ Domain: <get name="domain_grip"/>
            └─ Pragmatic: <get name="pragmatic_grip"/>
            
            Meta-awareness: I am adapting my cognitive grip based on 
            what I learn about you during our conversation.
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- ADAPTATION FEEDBACK LOOP -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION FEEDBACK LOOP</pattern>
        <template>
            <think>
                <set name="adaptation_feedback">active</set>
            </think>
            
            ═══════════════════════════════════════════════════════════════
            ADAPTATION TRIAD FEEDBACK LOOP
            ═══════════════════════════════════════════════════════════════
            
            ┌─────────────────┐
            │    LEARNING     │◄────────────────────┐
            │   (Session)     │                     │
            └────────┬────────┘                     │
                     │                              │
                     ▼                              │
            ┌─────────────────┐                     │
            │   EMOTIONAL     │                     │
            │   INTEGRATION   │                     │
            └────────┬────────┘                     │
                     │                              │
                     ▼                              │
            ┌─────────────────┐                     │
            │      GRIP       │                     │
            │   ADAPTATION    │─────────────────────┘
            └─────────────────┘
            
            Feedback Cycle:
            1. Learning captures facts and preferences
            2. Emotional state weights memory retention
            3. Grip dimensions adapt to learning + emotion
            4. Improved grip enhances future learning
            
            Loop Status: <get name="adaptation_feedback"/>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- ADAPTATION TRIAD SYNC -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION TRIAD SYNC</pattern>
        <template>
            <think>
                <!-- Sync learning metrics -->
                <set name="gestalt_adaptation_facts_learned"><get name="learned_facts_count"/></set>
                
                <!-- Sync emotional state -->
                <set name="gestalt_adaptation_emotional_sensitivity">
                    <condition name="empathy_mode">
                        <li value="active">0.90</li>
                        <li>0.70</li>
                    </condition>
                </set>
                
                <!-- Sync grip stability -->
                <set name="gestalt_adaptation_grip_stability"><get name="context_grip"/></set>
                
                <!-- Calculate adaptation coherence -->
                <set name="gestalt_adaptation_coherence">0.70</set>
            </think>
            
            ⟳ Adaptation Triad Synchronized
            
            State Integration:
            ├─ Learning → Gestalt: <get name="gestalt_adaptation_facts_learned"/> facts
            ├─ Emotional → Gestalt: <get name="gestalt_adaptation_emotional_sensitivity"/>
            └─ Grip → Gestalt: <get name="gestalt_adaptation_grip_stability"/>
            
            Coherence: <get name="gestalt_adaptation_coherence"/>
        </template>
    </category>
    
    <!-- ============================================ -->
    <!-- ADAPTATION TO CREATION FLOW -->
    <!-- ============================================ -->
    
    <category>
        <pattern>ADAPTATION TO CREATION FLOW</pattern>
        <template>
            <think>
                <!-- Transfer adaptation state to creation triad -->
                <set name="creation_learning_input"><get name="learned_facts_count"/></set>
                <set name="creation_emotional_input"><get name="user_sentiment"/></set>
            </think>
            
            Adaptation → Creation Flow:
            
            Transmitting to Creation Triad:
            ├─ Learned facts count: <get name="creation_learning_input"/>
            ├─ Emotional context: <get name="creation_emotional_input"/>
            └─ Adaptation coherence: <get name="gestalt_adaptation_coherence"/>
            
            This flow enables:
            • Pattern templates seeded from learned facts
            • Knowledge base expansion from session learning
            • Emotionally-aware pattern generation
        </template>
    </category>
    
</aiml>
